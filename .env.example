OPENROUTER_API_KEY=
# Chat model used to pick sermon start/end
OPENROUTER_MODEL=google/gemini-2.5-flash
# Whisper model used to transcribe audio
OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3

# Optional: other providers if you stop using OpenRouter
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Private dashboard (required for the web UI)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=changeme

# Optional yt-dlp tuning for link jobs
# Prefer H.264 so intro/ending packaging stays fast (AV1 is slow to re-encode):
# YTDLP_FORMAT=bv*[vcodec^=avc1][height<=1080]+ba[acodec^=mp4a]/b[ext=mp4][height<=1080]/b
# YTDLP_COOKIES_FILE=/data/cookies.txt

# Optional: how often to look for new videos on watched channels (seconds)
# CHANNEL_POLL_SECONDS=900
# CHANNEL_RECENT_VIDEOS=20
